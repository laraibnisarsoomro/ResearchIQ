# Anthropic API key — required for LLM-generated qualitative content.
# Without this key the app still works using template-based text.
ANTHROPIC_API_KEY=sk-ant-...

# Cache TTLs (seconds). Defaults shown below.
PRICE_CACHE_TTL=3600        # 1 hour
INFO_CACHE_TTL=86400        # 24 hours
FINANCIALS_CACHE_TTL=604800 # 7 days
NEWS_CACHE_TTL=14400        # 4 hours
SECTOR_STATS_TTL=86400      # 24 hours

# How many sector peers to use for benchmarks (0 = use all available cached)
MAX_SECTOR_PEERS=40

# Path to local data directory (relative to project root)
DATA_DIR=data

# LLM model to use for research synthesis
LLM_MODEL=claude-sonnet-4-6
